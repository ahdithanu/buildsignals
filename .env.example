# ── Frontend ─────────────────────────────────────────────────────────────────
# Backend API base URL (FastAPI)
# For local development, point to your local FastAPI server
VITE_API_BASE_URL=http://localhost:8000

# Frontend Sentry (separate project from the backend DSN — same org, per-app
# projects so events group correctly). Leave unset to disable. All VITE_* vars
# are baked at build time; changing them requires a static-site rebuild on
# Render, not a service restart.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_APP_VERSION=  # commit sha; Render Static Sites expose $RENDER_GIT_COMMIT at build time

# ── Backend ──────────────────────────────────────────────────────────────────
# Environment: development | staging | production
# In production the app refuses to start if CORS_ALLOWED_ORIGINS is empty or contains "*".
ENVIRONMENT=development
# Sentry error tracking. Leave unset to disable.
# Get DSN from https://sentry.io/ → project settings → Client Keys (DSN).
# SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.0

# Database. Render/Heroku-style postgres:// is auto-rewritten to postgresql://.
# Leave unset locally to use SQLite at ./dealsignal.db.
# DATABASE_URL=postgresql://user:pass@host:5432/dealsignal

# JWT signing secret. REQUIRED to be overridden in production.
SECRET_KEY=dev-secret-change-in-production
# Short-lived access token (Authorization: Bearer). Frontend keeps this in
# memory and drops it on page reload — a silent /auth/refresh re-issues.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Long-lived refresh token, carried as an httpOnly Secure cookie scoped to
# /auth. XSS cannot read it; rotated on every /auth/refresh call.
REFRESH_TOKEN_EXPIRE_DAYS=14
# Cookie attributes. SECURE must be true in production (HTTPS); must be
# false when serving over http://localhost or browsers drop the cookie.
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_NAME=ds_refresh

# CORS — comma-separated list of allowed frontend origins.
# Dev default (when unset): http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080
# Production example:       https://app.dealsignal.com,https://staging.dealsignal.com
# CORS_ALLOWED_ORIGINS=https://app.dealsignal.com

# Authentication posture.
# - true  (default dev): requests without a valid Bearer token fall through to
#         the default org + system user (demo mode). Required by legacy tests.
# - false (default prod): non-public routes without a valid Bearer token
#         return 401. Production refuses to start with ALLOW_ANONYMOUS=true.
# Public paths are always reachable: /health, /auth/login, /auth/register, /docs.
# ALLOW_ANONYMOUS=true

# Postgres row-level security test URL.
# When set, tests/test_rls_postgres.py runs against this database and asserts
# that RLS policies from migration 003 actually block cross-org reads/writes.
# Requires `alembic upgrade head` to have run against this URL first.
# TEST_POSTGRES_URL=postgresql://user:pass@localhost:5432/dealsignal_test

# Global per-IP rate limit backstop. Per-route auth limits are tighter and
# live separately in app/services/rate_limiter.py.
# GLOBAL_RATE_LIMIT=600
# GLOBAL_RATE_WINDOW_SECONDS=60

# Redis for the rate limiter. When unset, the in-memory backend runs
# (per-worker buckets — fine for a single-process pilot). When set,
# limits are enforced globally across all workers/pods. Fails open on
# Redis errors so a flap doesn't take the app down.
# REDIS_URL=redis://:password@host:6379/0
