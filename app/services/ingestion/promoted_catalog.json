[
  {
    "key": "bend_or_planning_applications",
    "name": "Bend Planning Applications",
    "adapter": "arcgis",
    "record_type": "permit",
    "jurisdiction": "Bend, OR",
    "base_url": "https://services5.arcgis.com/JisFYcK2mIVg9ueP/ArcGIS/rest/services/Planning/FeatureServer/0",
    "settings": {
      "connector": {
        "page_size": 500,
        "where": "ApplicationNumber IS NOT NULL",
        "out_fields": "OBJECTID,GNMasterProjectID,GNCommonID,PL_RecordID,ApplicationNumber,ApplicationDate,ApplicationDescription,ProjectTypeCode,ApplicationTypeCode,AppStatus,AppStatusDesc,Address,TAXLOT,DecisionDate,LASTUPDATE,OverallStatus",
        "order_by_fields": "LASTUPDATE DESC, OBJECTID ASC",
        "include_geometry": false,
        "include_centroid": true,
        "query": {
          "f": "json",
          "outSR": 4326
        }
      },
      "defaults": {
        "city": "Bend",
        "state": "OR",
        "jurisdiction": "Bend",
        "permit_type": "planning_application",
        "approval_stage": "pre_approval"
      },
      "signal_stage": "pre_approval_and_approved",
      "canary_stage_probes": [
        {
          "name": "bend_planning_pre_approval",
          "expected_stage": "pre_approval",
          "sample_size": 5,
          "connector": {
            "where": "ApplicationNumber IS NOT NULL AND DecisionDate IS NULL"
          }
        },
        {
          "name": "bend_planning_approved",
          "expected_stage": "approved",
          "sample_size": 5,
          "connector": {
            "where": "ApplicationNumber IS NOT NULL AND DecisionDate IS NOT NULL"
          }
        }
      ],
      "official_landing_page": "https://data.bendoregon.gov/datasets/bendoregon::planning-table",
      "license": "Custom License",
      "license_url": "https://data.bendoregon.gov/datasets/bendoregon::planning-table",
      "reconciliation_mode": "nightly_full_snapshot",
      "freshness_field": "LASTUPDATE",
      "freshness_semantics": "record_updated_at",
      "freshness_sla_hours": 72,
      "refresh_frequency": "nightly",
      "attribution_required": true,
      "field_allowlist": [
        "Address",
        "AppStatus",
        "AppStatusDesc",
        "ApplicationDate",
        "ApplicationDescription",
        "ApplicationNumber",
        "ApplicationTypeCode",
        "DecisionDate",
        "GNCommonID",
        "GNMasterProjectID",
        "LASTUPDATE",
        "OBJECTID",
        "OverallStatus",
        "PL_RecordID",
        "ProjectTypeCode",
        "TAXLOT",
        "centroid",
        "geometry"
      ],
      "suppressed_fields": [
        "AssignedPlanner",
        "CREATEDBY",
        "UPDATEDBY",
        "GlobalID",
        "raw_geometry_export",
        "raw_source_export"
      ],
      "canary_required_fields": [
        "OBJECTID",
        "ApplicationNumber",
        "ApplicationDate",
        "LASTUPDATE"
      ],
      "export_policy": "derived_permit_and_planning_intelligence_only_no_raw_source_export",
      "rights_basis": "Approved by Build Signals on 2026-08-02 for commercial storage, analysis, and customer-facing derived intelligence. Preserve City of Bend attribution, source links, currentness notices, and no raw source-replacement export.",
      "candidate_key": "bend_or_planning_applications",
      "candidate_status": "approved_for_production",
      "candidate_canary_completed_on": "2026-08-02"
    },
    "is_active": true,
    "field_mappings": [
      {
        "source_field": "ApplicationNumber",
        "canonical_field": "source_record_id",
        "is_required": true,
        "is_active": true
      },
      {
        "source_field": "__permit_number",
        "canonical_field": "permit_number",
        "transform": "first_nonempty",
        "transform_options": {"fields": ["ApplicationNumber"]},
        "is_active": true
      },
      {
        "source_field": "ApplicationDate",
        "canonical_field": "filed_at",
        "is_active": true
      },
      {
        "source_field": "DecisionDate",
        "canonical_field": "approved_at",
        "is_active": true
      },
      {
        "source_field": "__approval_stage",
        "canonical_field": "approval_stage",
        "transform": "conditional_map",
        "is_active": true,
        "transform_options": {
          "cases": [
            {
              "field": "DecisionDate",
              "operator": "present",
              "value": "approved"
            }
          ],
          "default": "pre_approval"
        }
      },
      {
        "source_field": "AppStatusDesc",
        "canonical_field": "status",
        "is_active": true
      },
      {
        "source_field": "ApplicationDescription",
        "canonical_field": "description",
        "is_active": true
      },
      {
        "source_field": "Address",
        "canonical_field": "address",
        "is_active": true
      },
      {
        "source_field": "TAXLOT",
        "canonical_field": "parcel_id",
        "is_active": true
      },
      {
        "source_field": "ApplicationTypeCode",
        "canonical_field": "permit_subtype",
        "is_active": true
      },
      {
        "source_field": "ProjectTypeCode",
        "canonical_field": "permit_type",
        "is_active": true
      },
      {
        "source_field": "OverallStatus",
        "canonical_field": "status",
        "is_active": true
      },
      {
        "source_field": "LASTUPDATE",
        "canonical_field": "status_updated_at",
        "is_active": true
      },
      {
        "source_field": "centroid",
        "canonical_field": "latitude",
        "transform": "object_path",
        "is_active": true,
        "transform_options": {
          "path": [
            "y"
          ]
        }
      },
      {
        "source_field": "__longitude",
        "canonical_field": "longitude",
        "transform": "object_path",
        "is_active": true,
        "transform_options": {
          "source_field": "centroid",
          "path": [
            "x"
          ]
